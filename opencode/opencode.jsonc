{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "mcp": {
    "ado": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp@next",
        "HC-MFD"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
